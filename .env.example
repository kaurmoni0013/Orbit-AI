NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://localhost:27017/orbit-ai?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OPENROUTER_API_KEY=replace-with-your-openrouter-key
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
ALLOWED_MODELS=openai/gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=60000
AI_STREAM_FIRST_BYTE_TIMEOUT_MS=15000
AI_STREAM_IDLE_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
AI_CONTEXT_CHAR_LIMIT=24000
AI_SUMMARY_CHAR_LIMIT=6000
SUMMARY_LOCK_TTL_SECONDS=120
TOKEN_LIMIT=10000
TOKEN_WINDOW_SECONDS=18000
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
UNAUTH_RATE_LIMIT=10
UNAUTH_RATE_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Orbit AI <no-reply@example.com>
RESEND_API_KEY=
MAIL_FROM=
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
